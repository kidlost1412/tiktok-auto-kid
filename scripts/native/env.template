APP_NAME="TikTok Auto Kid"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8010
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=tiktok_auto
DB_USERNAME=postgres
DB_PASSWORD=

# Khong Redis / Horizon / Reverb / Mailpit: dung database
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=960
CACHE_STORE=database
FILESYSTEM_DISK=public

# Hub san xuat (thu muc) va API hub
FORK_HUB_PATH=
# Xuong Video (hub): XUONG_DATA = thu muc du lieu cua hub (cung thu muc voi FORK_HUB_PATH). setup.ps1 dien san: <repo>/du-lieu/xuong-video.
# XUONG_PYTHON (tuy chon) = python.exe rieng; mac dinh runtime/xuong-venv. Launcher doc 2 bien nay (hoac "vars" trong runtime/services.json).
XUONG_DATA=
XUONG_URL=http://127.0.0.1:8765
XUONG_HEALTH_URL=http://127.0.0.1:8765/health
FORK_HUB_URL=http://127.0.0.1:8766
# Caddy phat file video/anh bia truc tiep (PHP chi kiem quyen) - khong giu worker php-cgi
FORK_ACCEL=true
FORK_HUB_KEY=
FORK_CHROME_EXTENSION_ID=
FORK_CHROME_LAUNCHER_SECRET=

# Che do mot nguoi dung: bo dang nhap/dang ky, tu vao /auto, chi nhan request tu loopback
APP_SINGLE_USER=true

# Kho GitHub chua ban phat hanh (nut Cap nhat trong app)
UPDATE_REPO=kidlost1412/tiktok-auto-kid
