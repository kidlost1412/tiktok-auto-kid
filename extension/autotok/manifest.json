{
  "manifest_version": 3,
  "name": "TikTok Auto Kid – tiện ích",
  "description": "Cau noi giua ung dung TikTok Auto Kid va Chrome: dang TikTok tu profile da dang nhap.",
  "version": "1.4.2",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "tabs", "background"],
  "host_permissions": ["https://www.tiktok.com/*", "https://shop.tiktok.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/tiktokstudio/*"],
      "js": ["lib.js", "studio-lib.js", "hook-main.js", "api-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/tiktokstudio/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "TikTok Auto Kid", "default_popup": "popup.html" }
}
